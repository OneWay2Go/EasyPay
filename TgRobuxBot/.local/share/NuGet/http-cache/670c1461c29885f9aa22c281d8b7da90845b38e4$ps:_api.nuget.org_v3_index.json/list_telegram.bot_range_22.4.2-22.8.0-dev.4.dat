up/net6.0/system.text.json","@type":"PackageDependency","id":"System.Text.Json","range":"[8.0.5, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"}],"targetFramework":"net6.0"},{"@id":"https://api.nuget.org/v3/catalog0/data/2025.04.11.22.20.20/telegram.bot.22.5.0.json#dependencygroup/.netstandard2.0","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2025.04.11.22.20.20/telegram.bot.22.5.0.json#dependencygroup/.netstandard2.0/indexrange","@type":"PackageDependency","id":"IndexRange","range":"[1.0.3, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/indexrange/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2025.04.11.22.20.20/telegram.bot.22.5.0.json#dependencygroup/.netstandard2.0/microsoft.extensions.options.configurationextensions","@type":"PackageDependency","id":"Microsoft.Extensions.Options.ConfigurationExtensions","range":"[8.0.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.extensions.options.configurationextensions/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2025.04.11.22.20.20/telegram.bot.22.5.0.json#dependencygroup/.netstandard2.0/system.componentmodel.annotations","@type":"PackageDependency","id":"System.ComponentModel.Annotations","range":"[5.0.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.componentmodel.annotations/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2025.04.11.22.20.20/telegram.bot.22.5.0.json#dependencygroup/.netstandard2.0/system.text.json","@type":"PackageDependency","id":"System.Text.Json","range":"[8.0.5, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2025.04.11.22.20.20/telegram.bot.22.5.0.json#dependencygroup/.netstandard2.0/system.threading.tasks.extensions","@type":"PackageDependency","id":"System.Threading.Tasks.Extensions","range":"[4.5.4, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.threading.tasks.extensions/index.json"}],"targetFramework":".NETStandard2.0"}],"description":"This library gives you easy access to Telegram Bot API so you can start building useful bots for Telegram.\n\nRelease Notes:\n- Support for Bot API 9.0\n- Removed the *Async-suffixed versions of the methods that were marked [Obsolete] since v22.0.\n- Services.ConfigureTelegramBot* is no longer necessary to make your Webhook bot compatible with Telegram updates!\n- Removed dependency on ASP.NET Core (Microsoft.AspNetCore.App) from the main library\n- Merged the Telegram.Bot.Extensions.Passport package into the main library\n- New HtmlText helpers method: ToPlain, PlainLength and Truncate to get the plain text only from HTML text (remove the <tags>), the number of plain text characters, or truncate the HTML to a number of plain text characters (useful to comply with the 4096/1024 message limit)\n- Added constructor ChatAdministratorRights(bool) to set all fields to true or false (except IsAnonymous)\n- Added helper property message.IsServiceMessage to detect service messages vs content messages\n\n2 small breaking changes:\n- Merged AnswerShippingQuery method overloads. You'll need to add errorMessage: in your code to pass that argument and indicate failure.\n- The Poll.Type is now an enum PollType instead of string\n\nMore details: https://telegrambots.github.io/book/migrate/Version-22.x.html#whats-new-in-version-225","iconUrl":"https://api.nuget.org/v3-flatcontainer/telegram.bot/22.5.0/icon","id":"Telegram.Bot","language":"","licenseExpression":"MIT","licenseUrl":"https://www.nuget.org/packages/Telegram.Bot/22.5.0/license","readmeUrl":"https://www.nuget.org/packages/Telegram.Bot/22.5.0#show-readme-container","listed":true,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/telegram.bot/22.5.0/telegram.bot.22.5.0.nupkg","projectUrl":"https://github.